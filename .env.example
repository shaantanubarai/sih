# Copy to .env for local development. Never commit real secrets.
APP_NAME=Secure Legal DMS
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+psycopg2://dms:dms_dev_password@postgres:5432/legal_dms
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_BUCKET=legal-documents
MINIO_SECURE=false

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_UPLOAD_BYTES=20971520
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=60/minute

# Demo seed passwords (local only)
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=DemoAdmin!234
SEED_OFFICER_PASSWORD=DemoOfficer!234
SEED_LEGAL_PASSWORD=DemoLegal!234
SEED_PROSECUTOR_PASSWORD=DemoProsecutor!234
SEED_AUDITOR_PASSWORD=DemoAuditor!234
SEED_COURT_PASSWORD=DemoCourt!234
SEED_VIEWER_PASSWORD=DemoViewer!234
